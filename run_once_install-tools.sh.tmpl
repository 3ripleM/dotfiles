#!/bin/bash
# run_once_install-tools.sh.tmpl
# chezmoi runs this exactly once per machine (tracked by content hash).
# ~/Brewfile is applied by chezmoi before this script runs.
set -e

if [ "${SKIP_INSTALL_TOOLS:-0}" = "1" ] || [ "${CHEZMOI_SKIP_INSTALL_TOOLS:-0}" = "1" ]; then
  echo "✓ Skipping tool installation bootstrap (SKIP_INSTALL_TOOLS=1)"
  exit 0
fi

failed_packages=()

report_failed_packages() {
  if [ "${#failed_packages[@]}" -ne 0 ]; then
    echo
    echo "⚠️  Some package installs failed:"
    for pkg in "${failed_packages[@]}"; do
      echo "  - $pkg"
    done
    echo
    echo "Please install these manually and rerun this script or use chezmoi apply again."
  fi
}

{{ if eq .chezmoi.os "darwin" -}}
# ── macOS ──────────────────────────────────────────────────────────────────────

if ! command -v brew &>/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew tap nikitabobko/tap 2>/dev/null || true
if ! brew bundle install --file="$HOME/Brewfile" --no-lock; then
  failed_packages+=("brew bundle packages")
fi

{{ else if eq .chezmoi.os "linux" -}}
# ── Linux (Debian/Ubuntu) ──────────────────────────────────────────────────────
if command -v apt-get >/dev/null 2>&1; then
  if ! sudo apt-get update -qq; then
    failed_packages+=("apt-get update")
  fi
  if ! sudo apt install software-properties-common -y; then
    failed_packages+=("software-properties-common")
  fi

  if ! sudo apt-add-repository ppa:fish-shell/release-4; then
    failed_packages+=("fish-shell PPA")
  fi
  if ! sudo apt-get update -qq; then
    failed_packages+=("apt-get update")
  fi

  packages=(git curl tmux fish ripgrep fd-find fzf lazygit ruby)
  for pkg in "${packages[@]}"; do
    if ! sudo apt-get install -y "$pkg"; then
      failed_packages+=("$pkg")
    fi
  done
else
  echo "⚠️  apt-get not found; skipping Debian/Ubuntu package install."
  failed_packages+=(git curl tmux fish ripgrep fd-find fzf lazygit ruby)
fi

# Neovim: install latest AppImage
if curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz; then
  if sudo tar -C /opt -xzf nvim-linux-x86_64.tar.gz; then
    sudo ln -sf /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim
  else
    failed_packages+=("neovim")
  fi
  rm -f nvim-linux-x86_64.tar.gz
else
  failed_packages+=("neovim")
fi

# uv
if ! command -v uv &>/dev/null; then
  if ! curl -LsSf https://astral.sh/uv/install.sh | sh; then
    failed_packages+=("uv")
  fi
fi

{{- end }}

# ── Both platforms ─────────────────────────────────────────────────────────────

# TPM
if [ -d "$HOME/.tmux/plugins/tpm" ]; then
  :
elif command -v git >/dev/null 2>&1; then
  if ! git clone --depth=1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"; then
    failed_packages+=("tmux-plugins/tpm")
  fi
else
  failed_packages+=("git (needed for tmux TPM clone)")
fi

# catppuccin for tmux (manually installed, not via TPM)
if [ -d "$HOME/.tmux/plugins/catppuccin" ]; then
  :
elif command -v git >/dev/null 2>&1; then
  if ! git clone --depth=1 https://github.com/catppuccin/tmux.git "$HOME/.tmux/plugins/catppuccin"; then
    failed_packages+=("catppuccin")
  fi
else
  failed_packages+=("git (needed for catppuccin clone)")
fi

# Herdr (terminal workspace manager) + herdr-splits plugin
if command -v herdr >/dev/null 2>&1; then
  :
elif ! curl -fsSL https://herdr.dev/install.sh | sh; then
  failed_packages+=("herdr")
fi

if command -v herdr >/dev/null 2>&1; then
  if herdr plugin list 2>/dev/null | grep -q herdr-splits; then
    :
  elif ! herdr plugin install lmilojevicc/herdr-splits.nvim --yes; then
    failed_packages+=("herdr plugin herdr-splits")
  fi
fi

# Fisher + plugins (reads ~/.config/fish/fish_plugins file applied by chezmoi)
if command -v fish &>/dev/null; then
  fish -c "
    if not functions -q fisher
      curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    end
    fisher update
  "
fi

# Set fish as default shell
FISH_PATH="$(command -v fish)"
if [ -n "$FISH_PATH" ]; then
  grep -qxF "$FISH_PATH" /etc/shells || echo "$FISH_PATH" | sudo tee -a /etc/shells
  [ "$SHELL" = "$FISH_PATH" ] || chsh -s "$FISH_PATH"
fi

if [ "${#failed_packages[@]}" -ne 0 ]; then
  report_failed_packages
  echo "✓ Bootstrap completed with warnings — open a new terminal after installing missing packages."
else
  echo "✓ Bootstrap complete — open a new terminal"
fi
